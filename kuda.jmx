            <stringProp name="parameters">wait-members</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.atomic.AtomicReference
def run=props.get('kudaLoad')
def room=vars.getObject('roomJob')
String action=args[0]
try {
 switch(action) {
 case 'wait-members':
  vars.put('waitMore','true')
  vars.put('waitKind',action)
  long seconds=action=='wait-members' ? vars.get('joinTimeoutSeconds').toLong() : vars.get('votingTimeoutSeconds').toLong()
  vars.put('waitUntil',(System.currentTimeMillis()+seconds*1000L).toString())
  if(action=='wait-finished') room.hostPaused.set(true)
  break
 }
 SampleResult.setIgnore()
} catch(Exception e) {
 vars.put('ok','false');vars.put('reason',e.message ?: e.class.simpleName)
 if(room!=null) room.cancelled.set(true)
 if(action.startsWith('take-')) vars.put('workerRunning','false')
 SampleResult.setSuccessful(false)
 SampleResult.setResponseCode('SCENARIO_ERROR')
 SampleResult.setResponseMessage(e.message ?: e.class.simpleName)
}
</stringProp>
          </JSR223Sampler>
          <hashTree />
          <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Ждать | members" enabled="true">
            <stringProp name="WhileController.condition">${__groovy(vars.get('ok') == 'true' &amp;&amp; !vars.getObject('roomJob').cancelled.get() &amp;&amp; vars.get('waitMore') == 'true' &amp;&amp; System.currentTimeMillis() &lt; vars.get('waitUntil').toLong())}</stringProp>
          </WhileController>
          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SSE | Ждать members" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="filename" />
              <stringProp name="parameters" />
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def room=vars.getObject('roomJob')
long deadline=vars.get('waitUntil').toLong()
def state=null;boolean ready=false
while(!room.cancelled.get() &amp;&amp; System.currentTimeMillis()&lt;deadline){
 state=room.streams.get(vars.get('userId'))
 ready=state!=null &amp;&amp; (state.members.size()&gt;=4)
 if(ready)break
 Thread.sleep(100)
}
vars.put('waitMore',(!ready).toString())
SampleResult.setResponseCode(ready?'200':'SSE_TIMEOUT');SampleResult.setSuccessful(ready)
SampleResult.setResponseData(groovy.json.JsonOutput.toJson(state ?: [:]),'UTF-8')
</stringProp>
            </JSR223Sampler>
