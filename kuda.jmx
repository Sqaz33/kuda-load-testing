      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Инициализировать прогон" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="filename" />
          <stringProp name="parameters" />
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonOutput
import java.util.concurrent.LinkedBlockingQueue
import java.util.concurrent.atomic.AtomicInteger
import org.apache.jmeter.services.FileServer
def mode = vars.get('mode')
def rates=vars.get('stageRates').split('\\|').collect { it.toInteger() }
assert rates.every { it&gt;0 } &amp;&amp; vars.get('stepSeconds').toInteger()&gt;0
int duration = mode == 'smoke' ? vars.get('smokeRooms').toInteger() : vars.get('stepSeconds').toInteger()*rates.size()
boolean continuous=mode!='smoke' &amp;&amp; props.getProperty('continuous','false').toBoolean()
int arrivalCeiling=props.getProperty('arrivalCeiling','512').toInteger()
if(continuous) duration=props.getProperty('loadSeconds','3390').toInteger()
def schedule = mode == 'smoke' ? 'rate(1/sec) even_arrivals('+duration+' sec) rate(1/sec)' :
    rates.collect { 'rate('+it+'/min) even_arrivals('+vars.get('stepSeconds')+' sec) rate('+it+'/min)' }.join(' ')
if(continuous) schedule='rate('+arrivalCeiling+'/min) even_arrivals('+duration+' sec) rate('+arrivalCeiling+'/min)'
schedule += ' pause('+vars.get('drainSeconds')+' sec)'
new org.apache.jmeter.threads.openmodel.ScheduleParser(schedule).parse()
File base=new File(FileServer.getFileServer().getBaseDir())
String path=vars.get('outDir')
File output=path.startsWith('~/') ? new File(base,path.substring(2)) : new File(path)
if(!output.isAbsolute()) output=new File(base,path)
output.mkdirs()
def summary=new File(output,'rooms.csv')
if(!summary.exists() || summary.length()==0) summary.setText('roomId,result,winnerId,elapsedMs,reason\n','UTF-8')
props.put('kudaLoad',[members:new LinkedBlockingQueue(20000),polls:new LinkedBlockingQueue(20000),
 streams:new AtomicInteger(),streamErrors:new AtomicInteger(),streamReconnects:new AtomicInteger(),streamEvents:new AtomicInteger(),active:new AtomicInteger(),started:new AtomicInteger(),completed:new AtomicInteger(),failed:new AtomicInteger(),
 end:System.currentTimeMillis()+duration*1000L,
 hardEnd:System.currentTimeMillis()+(duration+vars.get('drainSeconds').toInteger())*1000L,
 continuous:continuous,arrivalCeiling:arrivalCeiling,targetRate:new AtomicInteger(props.getProperty('rampSeconds','0').toInteger()&gt;0?0:rates[0]),workerRate:new AtomicInteger(props.getProperty('rampSeconds','0').toInteger()&gt;0?1:rates[0]),arrivalCredit:props.getProperty('rampSeconds','0').toInteger()&gt;0?0:arrivalCeiling-rates[0],arrivalLock:new Object(),controlNext:0L,controlFile:new File(output,'load-control.json'),schedule:schedule,summary:summary,lock:new Object(),rates:rates,stepSeconds:vars.get('stepSeconds').toInteger(),phaseStart:System.currentTimeMillis(),durationSeconds:duration+vars.get('drainSeconds').toInteger(),telemetry:new File(output,'telemetry.json'),telemetryNext:new java.util.concurrent.atomic.AtomicLong(),stopArrivals:new java.util.concurrent.atomic.AtomicBoolean(),stopApplied:new java.util.concurrent.atomic.AtomicBoolean(),stopFile:new File(output,'stop-arrivals')])
props.put('kudaMeetingDate',java.time.LocalDate.now(java.time.ZoneId.of('Europe/Volgograd')).plusDays(2).toString())
log.info('Куда: '+mode+'; '+schedule)
SampleResult.setIgnore()
</stringProp>
        </JSR223Sampler>
        <hashTree />
      </hashTree>
      <org.apache.jmeter.threads.openmodel.OpenModelThreadGroup guiclass="org.apache.jmeter.threads.openmodel.gui.OpenModelThreadGroupGui" testclass="org.apache.jmeter.threads.openmodel.OpenModelThreadGroup" testname="Организаторы | Ступени комнат в минуту" enabled="true">
        <stringProp name="OpenModelThreadGroup.schedule">${__groovy(props.get('kudaLoad').schedule)}</stringProp>
        <stringProp name="OpenModelThreadGroup.random_seed">42</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
      </org.apache.jmeter.threads.openmodel.OpenModelThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Новая компания" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="filename" />
          <stringProp name="parameters">host-begin</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonOutput
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.atomic.AtomicReference
def run=props.get('kudaLoad')
def room=vars.getObject('roomJob')
String action=args[0]
try {
 switch(action) {
 case 'host-begin':
  if(run.stopFile.exists()) { run.stopArrivals.set(true); SampleResult.setIgnore(); ctx.getThread().stop(); return }
  if(run.continuous) {
   boolean admitted=false
   synchronized(run.arrivalLock) {
    long now=System.currentTimeMillis()
    if(now&gt;=run.controlNext) {
     run.controlNext=now+250L
     if(run.controlFile.exists()) {
      def control=new groovy.json.JsonSlurper().parse(run.controlFile,'UTF-8')
      int rate=control.rate as int
      if(rate&lt;0 || rate&gt;run.arrivalCeiling) throw new IllegalArgumentException('Invalid arrival rate: '+rate)
      run.targetRate.set(rate)
      run.workerRate.set(Math.max(run.workerRate.get(),rate))
     }
    }
    // Evenly admit only the requested fraction of potential Open Model starts.
    // Rejected starts perform no HTTP and create no business scenario or sample.
    run.arrivalCredit+=run.targetRate.get()
    if(run.targetRate.get()&gt;0 &amp;&amp; run.arrivalCredit&gt;=run.arrivalCeiling) {
     run.arrivalCredit-=run.arrivalCeiling; admitted=true
    }
   }
   if(!admitted) { SampleResult.setIgnore(); ctx.getThread().stop(); return }
  }
  vars.put('actorRole','host')
  run.active.incrementAndGet()
  run.started.incrementAndGet()
  vars.putObject('roomJob',null)
  room=null
  vars.put('ok','true')
  vars.put('reason','')
  vars.put('authToken','')
  vars.put('roomId','')
  vars.put('startedAt',System.currentTimeMillis().toString())
  vars.put('guestName','НТ организатор '+UUID.randomUUID().toString().take(8))
  vars.put('createKey',UUID.randomUUID().toString())
  def c=[city:'Волгоград',timeZone:'Europe/Volgograd',date:props.get('kudaMeetingDate'),
   time:'19:30',area:[type:'district',district:'Центральный'],categories:['bar','cafe','restaurant'],
   budgetMax:2000,partySize:4,deadlineMinutes:30,exclusions:[]]
  vars.put('constraintsJson',JsonOutput.toJson(c))
  vars.put('createJson',JsonOutput.toJson([constraints:c]))
  break
 }
 SampleResult.setIgnore()
} catch(Exception e) {
 vars.put('ok','false');vars.put('reason',e.message ?: e.class.simpleName)
 if(room!=null) room.cancelled.set(true)
 if(action.startsWith('take-')) vars.put('workerRunning','false')
 SampleResult.setSuccessful(false)
 SampleResult.setResponseCode('SCENARIO_ERROR')
 SampleResult.setResponseMessage(e.message ?: e.class.simpleName)
}
</stringProp>
        </JSR223Sampler>
        <hashTree />
