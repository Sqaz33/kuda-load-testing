        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Забрать задание опроса" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="filename" />
            <stringProp name="parameters">take-poll</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.atomic.AtomicReference
def run=props.get('kudaLoad')
def room=vars.getObject('roomJob')
String action=args[0]
try {

if(run.stopFile.exists() &amp;&amp; !run.stopApplied.getAndSet(true)) {
 run.end=System.currentTimeMillis(); run.hardEnd=run.end+vars.get('drainSeconds').toLong()*1000L
}
// Snapshot every ten seconds; this does not add HTTP traffic.
def telemetryNow=System.currentTimeMillis()
def telemetryNext=run.telemetryNext.get()
if(telemetryNow&gt;=telemetryNext &amp;&amp; run.telemetryNext.compareAndSet(telemetryNext,telemetryNow+10000L)) {
 def memberHead=run.members.peek();def pollHead=run.polls.peek()
 def data=[active_streams:run.streams.get(),stream_errors:run.streamErrors.get(),stream_reconnects:run.streamReconnects.get(),stream_events:run.streamEvents.get(),timestamp_seconds:telemetryNow/1000d,phase_started_seconds:run.phaseStart/1000d,active_rooms:run.active.get(),started_rooms:run.started.get(),completed_rooms:run.completed.get(),failed_rooms:run.failed.get(),member_queue:run.members.size(),poll_queue:run.polls.size(),member_queue_oldest_seconds:memberHead==null?0:Math.max(0L,telemetryNow-memberHead.queuedAt)/1000d,poll_queue_oldest_seconds:pollHead==null?0:Math.max(0L,telemetryNow-pollHead.queuedAt)/1000d]
 synchronized(run.lock) { run.telemetry.setText(JsonOutput.toJson(data),'UTF-8') }
}

 switch(action) {
 case 'take-poll':
  def queue=action=='take-member' ? run.members : run.polls
  if(System.currentTimeMillis()&gt;=run.hardEnd){vars.put('workerRunning','false');vars.put('hasJob','false');SampleResult.setIgnore();return}
  if(System.currentTimeMillis()&gt;run.end &amp;&amp; run.active.get()==0 &amp;&amp; queue.isEmpty()) {
   vars.put('workerRunning','false'); vars.put('hasJob','false'); break
  }
  def job=queue.poll(5,TimeUnit.SECONDS)
  vars.put('hasJob','false')
  if(job==null) break
  room=job.room
  vars.putObject('roomJob',room)
  if(room.cancelled.get()) {
   if(action=='take-poll') room.pending.decrementAndGet()
   break
  }
  vars.put('hasJob','true');vars.put('ok','true')
  vars.put('roomId',room.id);vars.put('inviteToken',room.invite)
  if(action=='take-member') {
   vars.put('actorRole','member')
   vars.put('authToken','')
   vars.put('guestName','НТ участник '+job.number+' '+UUID.randomUUID().toString().take(8))
  } else {
   vars.put('authToken',job.token);vars.put('userId',job.userId)
   vars.put('hostPoll',job.host.toString());vars.put('sawWinner','false')
  }
  break
 }
 SampleResult.setIgnore()
} catch(Exception e) {
 vars.put('ok','false');vars.put('reason',e.message ?: e.class.simpleName)
 if(room!=null) room.cancelled.set(true)
 if(action.startsWith('take-')) vars.put('workerRunning','false')
 SampleResult.setSuccessful(false)
 SampleResult.setResponseCode('SCENARIO_ERROR')
 SampleResult.setResponseMessage(e.message ?: e.class.simpleName)
}
</stringProp>
          </JSR223Sampler>
          <hashTree />
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Получено задание опроса" enabled="true">
            <stringProp name="IfController.condition">${hasJob}</stringProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SSE | Читать изменения комнаты" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="filename" />
              <stringProp name="parameters" />
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import java.net.HttpURLConnection

def run=props.get('kudaLoad');def room=vars.getObject('roomJob')
String uid=vars.get('userId');String token=vars.get('authToken')
HttpURLConnection connection=null
run.streams.incrementAndGet()
try {
 boolean connected=false
 while(!room.cancelled.get() &amp;&amp; System.currentTimeMillis()&lt;room.end){
  try {
   URL url=new URL(vars.get('protocol')+'://'+vars.get('host')+':'+vars.get('port')+'/v1/rooms/'+room.id+'/events')
   connection=(HttpURLConnection)url.openConnection()
   connection.setRequestProperty('Authorization','Bearer '+token)
   connection.setRequestProperty('Accept','text/event-stream')
   connection.setConnectTimeout(vars.get('responseTimeoutMs').toInteger());connection.setReadTimeout(20000)
   if(connection.responseCode!=200) throw new IllegalStateException('SSE HTTP '+connection.responseCode)
   if(connected) run.streamReconnects.incrementAndGet()
   connected=true
   def reader=new BufferedReader(new InputStreamReader(connection.inputStream,'UTF-8'))
   String event=''
   while(!room.cancelled.get() &amp;&amp; System.currentTimeMillis()&lt;room.end){
    String line=reader.readLine();if(line==null)break
    if(line.startsWith('event: '))event=line.substring(7)
    if(line.startsWith('data: ') &amp;&amp; event=='room'){
     def state=new JsonSlurper().parseText(line.substring(6))
     if(state.id!=room.id)throw new IllegalStateException('SSE другой комнаты')
     room.streams.put(uid,state);run.streamEvents.incrementAndGet()
     if(state.winner &amp;&amp; room.winner.get()){
      if(state.winner.id!=room.winner.get())throw new IllegalStateException('SSE другой победитель')
      vars.put('sawWinner','true')
     }
    }
    if(event=='access_revoked')throw new IllegalStateException('SSE доступ отозван')
   }
   reader.close()
  } finally {if(connection!=null)connection.disconnect()}
  if(!room.cancelled.get() &amp;&amp; System.currentTimeMillis()&lt;room.end)Thread.sleep(250)
 }
 SampleResult.setIgnore()
} catch(Throwable e){
 if(!room.cancelled.get()){
  run.streamErrors.incrementAndGet();room.cancelled.set(true);vars.put('ok','false');vars.put('reason',e.message ?: e.class.simpleName)
  SampleResult.setSuccessful(false);SampleResult.setResponseCode('SSE_ERROR');SampleResult.setResponseMessage(e.message ?: e.class.simpleName)
 }else SampleResult.setIgnore()
} finally {run.streams.decrementAndGet();if(connection!=null)connection.disconnect()}
</stringProp>
            </JSR223Sampler>
            <hashTree />
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Проверить одинакового победителя" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="filename" />
              <stringProp name="parameters">poll-check</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonOutput
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.atomic.AtomicReference
def run=props.get('kudaLoad')
def room=vars.getObject('roomJob')
String action=args[0]
try {
 switch(action) {
 case 'poll-check':
  def seen=room.streams.get(vars.get('userId')); if(seen?.winner?.id==room.winner.get()) vars.put('sawWinner','true')
  if(!room.cancelled.get() &amp;&amp; vars.get('sawWinner')!='true') throw new IllegalStateException('Пользователь не увидел победителя')
  break
 }
 SampleResult.setIgnore()
} catch(Exception e) {
 vars.put('ok','false');vars.put('reason',e.message ?: e.class.simpleName)
 if(room!=null) room.cancelled.set(true)
 if(action.startsWith('take-')) vars.put('workerRunning','false')
 SampleResult.setSuccessful(false)
 SampleResult.setResponseCode('SCENARIO_ERROR')
 SampleResult.setResponseMessage(e.message ?: e.class.simpleName)
}
</stringProp>
            </JSR223Sampler>
            <hashTree />
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Освободить задание опроса" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="filename" />
              <stringProp name="parameters">poll-release</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonOutput
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.atomic.AtomicReference
def run=props.get('kudaLoad')
def room=vars.getObject('roomJob')
String action=args[0]
try {
 switch(action) {
 case 'poll-release':
  room.pending.decrementAndGet()
  break
 }
 SampleResult.setIgnore()
} catch(Exception e) {
 vars.put('ok','false');vars.put('reason',e.message ?: e.class.simpleName)
 if(room!=null) room.cancelled.set(true)
 if(action.startsWith('take-')) vars.put('workerRunning','false')
 SampleResult.setSuccessful(false)
 SampleResult.setResponseCode('SCENARIO_ERROR')
 SampleResult.setResponseMessage(e.message ?: e.class.simpleName)
}
</stringProp>
