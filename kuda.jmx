          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Передать три приглашения" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="filename" />
            <stringProp name="parameters">publish</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.atomic.AtomicReference
def run=props.get('kudaLoad')
def room=vars.getObject('roomJob')
String action=args[0]
try {
 switch(action) {
 case 'publish':
  room=[streams:new java.util.concurrent.ConcurrentHashMap(),id:vars.get('roomId'),invite:vars.get('inviteToken'),
   end:System.currentTimeMillis()+vars.get('roomViewSeconds').toLong()*1000L,
   cancelled:new AtomicBoolean(),winner:new AtomicReference(''),
   pending:new AtomicInteger(),hostPaused:new AtomicBoolean()]
  vars.putObject('roomJob',room)
  for(int i=1;i&lt;=3;i++) {
   if(!run.members.offer([room:room,number:i,queuedAt:System.currentTimeMillis()],2,TimeUnit.SECONDS)) throw new IllegalStateException('Очередь участников переполнена')
  }
  break
 }
 SampleResult.setIgnore()
} catch(Exception e) {
 vars.put('ok','false');vars.put('reason',e.message ?: e.class.simpleName)
 if(room!=null) room.cancelled.set(true)
 if(action.startsWith('take-')) vars.put('workerRunning','false')
 SampleResult.setSuccessful(false)
 SampleResult.setResponseCode('SCENARIO_ERROR')
 SampleResult.setResponseMessage(e.message ?: e.class.simpleName)
}
</stringProp>
          </JSR223Sampler>
          <hashTree />
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SSE | Подписать организатора" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="filename" />
            <stringProp name="parameters">poll-job</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.atomic.AtomicReference
def run=props.get('kudaLoad')
def room=vars.getObject('roomJob')
String action=args[0]
try {
 switch(action) {
 case 'poll-job':
  room.pending.incrementAndGet()
  if(!run.polls.offer([room:room,queuedAt:System.currentTimeMillis(),token:vars.get('authToken'),userId:vars.get('userId'),
      host:vars.get('actorRole')=='host'],2,TimeUnit.SECONDS)) {
   room.pending.decrementAndGet();throw new IllegalStateException('Очередь опроса переполнена')
  }
  break
 }
 SampleResult.setIgnore()
} catch(Exception e) {
 vars.put('ok','false');vars.put('reason',e.message ?: e.class.simpleName)
 if(room!=null) room.cancelled.set(true)
 if(action.startsWith('take-')) vars.put('workerRunning','false')
 SampleResult.setSuccessful(false)
 SampleResult.setResponseCode('SCENARIO_ERROR')
 SampleResult.setResponseMessage(e.message ?: e.class.simpleName)
}
</stringProp>
          </JSR223Sampler>
