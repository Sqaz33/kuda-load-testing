      <com.blazemeter.jmeter.threads.concurrency.ConcurrencyThreadGroup guiclass="com.blazemeter.jmeter.threads.concurrency.ConcurrencyThreadGroupGui" testclass="com.blazemeter.jmeter.threads.concurrency.ConcurrencyThreadGroup" testname="SSE | Динамический пул" enabled="true">
        <elementProp name="ThreadGroup.main_controller" elementType="com.blazemeter.jmeter.control.VirtualUserController" />
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <stringProp name="TargetLevel">${__groovy(def r=props.get('kudaLoad');if(System.currentTimeMillis()&gt;=r.hardEnd || System.currentTimeMillis()&gt;r.end &amp;&amp; r.active.get()==0 &amp;&amp; r.members.isEmpty() &amp;&amp; r.polls.isEmpty())return 0;int i=(int)((System.currentTimeMillis()-r.phaseStart)/(r.stepSeconds*1000L));if(i&gt;=r.rates.size())i=r.rates.size()-1;int n=(int)Math.ceil((r.continuous?r.workerRate.get():r.rates[i])*14.95);int cap=(props.getProperty('pollThreads')?:'0').toInteger();cap&gt;0 &amp;&amp; n&gt;cap?cap:n)}</stringProp>
        <stringProp name="RampUp" />
        <stringProp name="Steps" />
        <stringProp name="Hold">${__groovy(props.get('kudaLoad').durationSeconds)}</stringProp>
        <stringProp name="LogFilename" />
        <stringProp name="Iterations">1</stringProp>
        <boolProp name="same_user_on_next_iteration">true</boolProp>
        <stringProp name="Unit">S</stringProp>
      </com.blazemeter.jmeter.threads.concurrency.ConcurrencyThreadGroup>
      <hashTree>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Пока есть работа" enabled="true">
          <stringProp name="WhileController.condition">${workerRunning}</stringProp>
